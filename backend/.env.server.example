# Backend on the same server as Next.js (NO ngrok)
# Copy relevant lines to backend/.env

APP_URL=http://168.231.111.10:3000
FRONTEND_URL=http://168.231.111.10:3000

# Host:port only — NO http://. Must match Origin/Referer from the browser or curl -H "Origin: ...".
# Include the Next.js frontend AND the backend port if you test login directly on :8000.
SANCTUM_STATEFUL_DOMAINS=168.231.111.10:3000,168.231.111.10:8000,localhost:3000,127.0.0.1:3000

# Must match frontend origin exactly (with scheme).
CORS_ALLOWED_ORIGINS=http://168.231.111.10:3000

DB_HOST=127.0.0.1
DB_PORT=3306

SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# Mail — use smtp in production (default driver "log" only writes to laravel.log)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_REDIRECT_URI=http://168.231.111.10:3000/api/v1/auth/google/callback
