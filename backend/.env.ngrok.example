# Backend behind ngrok, frontend on http://168.231.111.10:3000 with Next.js proxy
# Copy relevant lines to backend/.env on the server

APP_URL=https://overarch-overlook-keep.ngrok-free.dev
FRONTEND_URL=http://168.231.111.10:3000

# Must match the browser address bar (host:port)
SANCTUM_STATEFUL_DOMAINS=168.231.111.10:3000

CORS_ALLOWED_ORIGINS=http://168.231.111.10:3000

# HTTP frontend — do not set Secure on session cookies
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

GOOGLE_REDIRECT_URI=https://overarch-overlook-keep.ngrok-free.dev/api/v1/auth/google/callback
