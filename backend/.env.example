# =============================================================================
# Business Management System – Laravel API (.env.example for Render)
# Copy these values into Render → Environment. Do NOT commit real secrets.
# =============================================================================

APP_NAME="Business Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api-service.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Render streams container stdout/stderr to the dashboard
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (REQUIRED) – MySQL or MariaDB
# Render Web Services do not include MySQL on the Free plan.
# Provision external MySQL/MariaDB (Railway, Aiven, MariaDB Cloud, etc.)
# and paste credentials here, OR set DATABASE_URL if your host provides it.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_DATABASE=bms
DB_USERNAME=bms
DB_PASSWORD=
# DB_URL=mysql://user:pass@host:3306/bms

# Optional: SSL CA path inside the container for managed MySQL providers
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# -----------------------------------------------------------------------------
# Session / Sanctum (SPA cookie auth with separate Next.js frontend)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless frontend + API share a parent domain (e.g. .example.com)
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=your-frontend.onrender.com,localhost:3000

# Comma-separated origins allowed by CORS (must include your frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Public URL of the Next.js frontend (used in task assignment emails)
FRONTEND_URL=https://your-frontend.onrender.com

# -----------------------------------------------------------------------------
# Cache, queue, filesystem
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Use "sync" on Render Free unless you add a Background Worker service
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Redis is optional; not required for Render Free deployment
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (SMTP – e.g. Gmail App Password)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Google OAuth (optional)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api-service.onrender.com/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Render sets PORT automatically – do not hard-code in Render dashboard
# -----------------------------------------------------------------------------
PORT=8000

VITE_APP_NAME="${APP_NAME}"
